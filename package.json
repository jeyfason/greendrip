{
  "name": "greendrip",
  "version": "1.0.1",
  "description": "Fill your GitHub contribution graph with realistic commits and keep it green with a daily drip",
  "type": "module",
  "main": "index.js",
  "bin": {
    "greendrip": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "docs/ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "start": "node index.js",
    "preview": "node index.js --preview",
    "today": "node index.js --daily"
  },
  "keywords": [
    "github",
    "contribution-graph",
    "git",
    "cli",
    "backfill",
    "commits",
    "green"
  ],
  "author": "Jey Fason",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeyfason/greendrip.git"
  },
  "dependencies": {
    "jsonfile": "^6.1.0",
    "moment": "^2.30.1",
    "random": "^4.1.0",
    "simple-git": "^3.25.0"
  }
}
